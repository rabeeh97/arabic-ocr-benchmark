# macOS
.DS_Store
._*
.AppleDouble

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.mypy_cache/

# env / secrets
.env
.env.local
# experiment.env / example.env hold real tokens and passwords
*.env
*.key

# data — never commit dataset images (see docs/datasets.md)
data/
!data/**/*.txt
!data/**/*.json.example

# benchmark outputs: run dirs ARE committed (that's how results come back from
# Colab). The per-line resume cache (results/_cache/) is ALSO committed now, so
# that a re-run — on any machine, on the free API stack — never repeats a call
# that already has an answer. Its files are tiny (<1 KB of JSON each).

# HF / model caches
.cache/
models_cache/

# training checkpoints / merged weights — these live on Google Drive + the HF
# Hub, never in git (notebook 05 points output_dir at Drive). This is a guard in
# case a run is pointed at the local tree by mistake.
results/training/

# Disposable copies pulled from the Windows 3090 box (suite_v1 merged VLMs,
# eval/bench scores). Not source; delete the folder any time. See
# suite-v1-artifacts/README.md.
suite-v1-artifacts/

# synthetic-data fonts — downloaded by scripts/fetch_fonts.py, not committed
# (OFL binaries). training/synth.py falls back to the bundled Noto Naskh.
src/arabic_ocr_bench/assets/fonts/

# notebooks
.ipynb_checkpoints/

# Disposable copies of the 3090 box's exp3090 result folders (same role as
# suite-v1-artifacts/). Scores that matter are merged into results/.
exp3090-results/

# stray run logs at the repo root
/*.log

# per-line profiler dump (~20 MB, regenerated by scripts/profile_datasets.py)
results/characterize/*/lines.jsonl
