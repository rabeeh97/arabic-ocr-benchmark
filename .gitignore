# macOS
.DS_Store
._*
.AppleDouble

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.mypy_cache/

# env / secrets
.env
.env.local
*.key

# data — never commit dataset images (see docs/datasets.md)
data/
!data/**/*.txt
!data/**/*.json.example

# benchmark outputs: run dirs ARE committed (that's how results come back from
# Colab). The per-line resume cache (results/_cache/) is ALSO committed now, so
# that a re-run — on any machine, on the free API stack — never repeats a call
# that already has an answer. Its files are tiny (<1 KB of JSON each).

# HF / model caches
.cache/
models_cache/

# notebooks
.ipynb_checkpoints/
