{
  "name": "pretrain-resume",
  "gpu": "T4",
  "max_units": 2.5,
  "max_minutes": 210,
  "poll_s": 60,
  "sync_every_s": 600,
  "final_sync_grace_min": 15,
  "uploads": [
    [
      "scripts/xai_train_aligner.py",
      "/content/xai_train_aligner.py"
    ],
    [
      "scripts/rasam_prepare_crnn_data.py",
      "/content/rasam_prepare_crnn_data.py"
    ],
    [
      "scripts/colab_remote_packs.py",
      "/content/colab_remote_packs.py"
    ],
    [
      "scripts/pretrain_external_pack.py",
      "/content/pretrain_external_pack.py"
    ],
    [
      "results/rasam/repairs/rasam2_recut.pkl",
      "/content/rasam2_recut.pkl"
    ],
    [
      "/Users/rabeehjouni/colab_staging/jobs/job-reptm-long-ema-t4-10261511/content/crnn_out/reptm_h96_w05_e60_ema/charset.json",
      "/content/e60_charset.json"
    ],
    [
      "/Users/rabeehjouni/colab_staging/jobs/job-pretrain-t4-10282207/content/crnn_out/pre_A/ckpt_last.pt",
      "/content/crnn_out/pre_A/ckpt_last.pt"
    ],
    [
      "/Users/rabeehjouni/colab_staging/jobs/job-pretrain-t4-10282207/content/crnn_out/pre_A/model_best.pt",
      "/content/crnn_out/pre_A/model_best.pt"
    ],
    [
      "/Users/rabeehjouni/colab_staging/jobs/job-pretrain-t4-10282207/content/crnn_out/pre_A/config.json",
      "/content/crnn_out/pre_A/config.json"
    ],
    [
      "/Users/rabeehjouni/colab_staging/jobs/job-pretrain-t4-10282207/content/crnn_out/pre_A/charset.json",
      "/content/crnn_out/pre_A/charset.json"
    ]
  ],
  "setup": [
    "mkdir -p /content/crnn_out/pre_A"
  ],
  "runs": [
    {
      "label": "packs",
      "cmd": "PACKS='[{\"out\": \"/content/pack_reptm_h96.pkl\", \"sets\": [\"RASAM-1\", \"RASAM-2\", \"tarima\"], \"height\": 96, \"repair\": \"/content/rasam2_recut.pkl\"}]' python /content/colab_remote_packs.py && cd /content && python -u /content/pretrain_external_pack.py /content/pack_reptm_h96.pkl /content/pack_pre_h96.pkl --charset /content/e60_charset.json --workers 4 | tee /content/crnn_out/pretrain_pack_stats.txt && rm -f /content/pack_reptm_h96.pkl"
    },
    {
      "label": "stageA",
      "cmd": "python -u /content/xai_train_aligner.py --data /content/pack_pre_h96.pkl --device cuda --width 0.5 --eval-every 2 --seed 0 --geom-aug --out /content/crnn_out/pre_A --epochs 12 --bs 32 --train-sets r1 r2 tm mu kh bb is"
    },
    {
      "label": "stageB",
      "cmd": "python -u /content/xai_train_aligner.py --data /content/pack_pre_h96.pkl --device cuda --width 0.5 --eval-every 2 --seed 0 --geom-aug --out /content/crnn_out/pre_B --epochs 30 --bs 16 --lr 1e-3 --train-sets r1 r2 tm --ema 0.999 --init /content/crnn_out/pre_A/model_best.pt"
    }
  ],
  "artifacts": [
    "/content/crnn_out"
  ],
  "local_out": "results/rasam/colab_runs"
}