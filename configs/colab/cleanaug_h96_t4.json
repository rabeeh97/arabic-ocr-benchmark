{
  "name": "cleanaug-h96",
  "gpu": "T4",
  "max_units": 2.6,
  "max_minutes": 135,
  "poll_s": 60,
  "sync_every_s": 300,
  "final_sync_grace_min": 15,
  "uploads": [
    ["scripts/xai_train_aligner.py", "/content/xai_train_aligner.py"],
    ["scripts/rasam_prepare_crnn_data.py", "/content/rasam_prepare_crnn_data.py"],
    ["scripts/colab_remote_packs.py", "/content/colab_remote_packs.py"],
    ["results/rasam/repairs/rasam2_recut.pkl", "/content/rasam2_recut.pkl"]
  ],
  "setup": ["PACKS='[{\"out\": \"/content/pack_rep_h96.pkl\", \"sets\": [\"RASAM-1\", \"RASAM-2\"], \"height\": 96, \"repair\": \"/content/rasam2_recut.pkl\"}, {\"out\": \"/content/pack_rep_dark_h96.pkl\", \"sets\": [\"RASAM-1\", \"RASAM-2\"], \"height\": 96, \"repair\": \"/content/rasam2_recut.pkl\", \"channel\": \"darkest\"}]' python /content/colab_remote_packs.py"],
  "runs": [
    {"label": "rep_h96_w05", "cmd": "python -u /content/xai_train_aligner.py --data /content/pack_rep_h96.pkl --out /content/crnn_out/rep_h96_w05 --epochs 30 --bs 16 --device cuda --width 0.5 --train-sets r1 r2 --eval-every 2 --seed 0 --geom-aug"},
    {"label": "rep_aug_h96_w05", "cmd": "python -u /content/xai_train_aligner.py --data /content/pack_rep_h96.pkl --out /content/crnn_out/rep_aug_h96_w05 --epochs 30 --bs 16 --device cuda --width 0.5 --train-sets r1 r2 --eval-every 2 --seed 0 --geom-aug --neighbor-aug 0.3 --fade-aug 0.3"},
    {"label": "rep_aug_dark_h96_w05", "cmd": "python -u /content/xai_train_aligner.py --data /content/pack_rep_dark_h96.pkl --out /content/crnn_out/rep_aug_dark_h96_w05 --epochs 30 --bs 16 --device cuda --width 0.5 --train-sets r1 r2 --eval-every 2 --seed 0 --geom-aug --neighbor-aug 0.3 --fade-aug 0.3"}
  ],
  "artifacts": ["/content/crnn_out"],
  "local_out": "results/rasam/colab_runs"
}
