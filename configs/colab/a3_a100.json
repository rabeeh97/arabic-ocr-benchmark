{
  "name": "a3-a100",
  "gpu": "A100",
  "max_units": 4.0,
  "max_minutes": 40,
  "poll_s": 60,
  "sync_every_s": 240,
  "uploads": [
    ["scripts/xai_train_aligner.py", "/content/xai_train_aligner.py"],
    ["scripts/rasam_prepare_crnn_data.py", "/content/rasam_prepare_crnn_data.py"],
    ["scripts/colab_remote_prepare_r12.py", "/content/colab_remote_prepare_r12.py"]
  ],
  "setup": ["python /content/colab_remote_prepare_r12.py"],
  "runs": [
    {"label": "a3_w05_bs16", "cmd": "python -u /content/xai_train_aligner.py --data /content/rasam_r12.pkl --out /content/crnn_out/a3_w05_bs16 --epochs 30 --bs 16 --device cuda --width 0.5 --train-sets r1 r2 --eval-every 2 --seed 0 --geom-aug"},
    {"label": "a3_w10_bs64", "cmd": "python -u /content/xai_train_aligner.py --data /content/rasam_r12.pkl --out /content/crnn_out/a3_w10_bs64 --epochs 30 --bs 64 --device cuda --width 1.0 --train-sets r1 r2 --eval-every 2 --seed 0 --geom-aug"}
  ],
  "artifacts": ["/content/crnn_out"],
  "local_out": "results/rasam/colab_runs"
}
