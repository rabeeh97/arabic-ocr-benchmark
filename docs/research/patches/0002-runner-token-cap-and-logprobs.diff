+def test_litellm_logprobs_only_requested_when_enabled(monkeypatch):
+    import litellm
+
+    calls = []
+    lp = SimpleNamespace(content=[SimpleNamespace(token="a", logprob=-0.1),
+                                  {"token": "b", "logprob": -2.0}])
+
+    def fake(**kw):
+        calls.append(kw)
+        return _resp("ab", "stop", logprobs=lp)
