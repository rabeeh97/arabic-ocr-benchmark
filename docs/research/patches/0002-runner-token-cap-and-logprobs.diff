+    monkeypatch.setattr(litellm, "completion", lambda **kw: _resp("ab"))
+    pred = LiteLLMClient("m", "openai/m", logprobs=True).transcribe(_img(), "p")
+    assert pred.token_logprobs is None and pred.logprob_kind is None
