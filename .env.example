# Copy to `.env` (git-ignored) and fill in the keys you have. Loaded automatically
# on any `arabic_ocr_bench` import — no need to `export` before every run.
# Real environment variables override these, so Colab secrets still work.
#
#   cp .env.example .env && chmod 600 .env

# --- hosted model providers (used by run_hosted.py / notebook 02) ---
ANTHROPIC_API_KEY=      # https://console.anthropic.com/settings/keys   -> claude-haiku / -sonnet / -opus
GEMINI_API_KEY=         # https://aistudio.google.com/apikey (free tier) -> gemini-2.5-flash / -pro / -flash-lite
OPENAI_API_KEY=         # https://platform.openai.com/api-keys           -> gpt-4o / gpt-4o-mini / gpt-4.1* / gpt-5
MISTRAL_API_KEY=        # https://console.mistral.ai/api-keys (free tier) -> pixtral-12b / mistral-small
OPENROUTER_API_KEY=     # https://openrouter.ai/keys — one key, many models incl. free -> openrouter-*

# --- Ollama cloud (ollama.com) — OpenAI-compatible endpoint ---
OLLAMA_API_KEY=         # https://ollama.com  (Settings -> Keys)
OLLAMA_API_BASE=https://ollama.com/v1   # or http://localhost:11434/v1 for a local Ollama

# --- datasets ---
HF_TOKEN=              # https://huggingface.co/settings/tokens — speeds/enables the Muharaf download
