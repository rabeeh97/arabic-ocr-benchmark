# Copy to .env and fill in the keys you have. Loaded by nothing automatically —
# `source` it, or export these in your shell, before `uv run bench run`.
# For Colab, set these as Secrets instead (see notebooks/README.md).

GEMINI_API_KEY=        # https://aistudio.google.com/apikey  (free tier available)
OPENAI_API_KEY=        # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=     # https://console.anthropic.com/settings/keys
HF_TOKEN=              # https://huggingface.co/settings/tokens  (only for gated models e.g. PaliGemma base)
